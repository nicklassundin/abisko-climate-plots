{{!-- extends default --}}
<!DOCTYPE html>
<html lang="en">
<meta>
    <title>{{title}}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta id="description">

    {{!-- Stylesheets --}}
    <link rel="stylesheet" type="text/css" href="css/styles.css">
    <link rel="stylesheet" type="text/css" href="css/highcharts.css">
    <link rel="stylesheet" type="text/css" href="css/series.css">
    <link rel="stylesheet" type="text/css" href="css/custom-highcharts.css">
    <link rel="stylesheet" href="res/style/leaflet.css">
    <link rel="stylesheet" href="res/style/style.css">
    <link rel="stylesheet" href="res/style/marker.css">
    <link rel="stylesheet" href="res/style/progressbar.css">
    <link rel="stylesheet" href="res/style/plotarea.css">
    <link rel="stylesheet" href="res/style/layout.css"> <!-- New CSS for layout -->
    <link rel="stylesheet" type="text/css" href="https://nicklassundin.github.io/abisko-climate-plots/css/highcharts.css">
    <link rel="stylesheet" type="text/css" href="https://nicklassundin.github.io/abisko-climate-plots/css/series.css">
    <link rel="stylesheet" type="text/css" href="https://nicklassundin.github.io/abisko-climate-plots/css/custom-highcharts.css">

    {{!-- jQuery --}}
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>

<script type="application/json" id="stations-data">
    {{{json stations}}}
</script>
</head>
<body>

<div class="main-layout">
    <div id="map" class="map-container"></div>

    <div class="plotArea">
        <div id="plotField" class="plotField">
            <div id="mark"></div>
        </div>
    </div>
</div>

<div id="loading-container" class="loading-container">
    <div id="progress-bar" class="progress-bar"></div>
</div>


<!-- Main Tab structure with buttons -->
<div class="plot-tabs">
    <ul class="tab-list">
        <li class="tab" data-tab="temperatureTab">Temperature</li>
        <li class="tab" data-tab="precipitationTab">Precipitation</li>
        <li class="tab" data-tab="snowDepthTab">Snow Depth</li>
        <li class="tab" data-tab="growingSeasonTab">Growing Season</li>
        <li class="tab" data-tab="atmosphereTab">Atmosphere</li>
        <li class="tab" data-tab="lakesTab">Lakes</li>
        <li class="tab" data-tab="permafrostTab">Permafrost</li>
        <li class="tab" data-tab="extremeWeatherTab">Extreme Weather</li>
    </ul>

    <!-- Main Tab Content with action buttons at the end -->
    <div id="tabContent">
        <!-- Temperature Tab Content -->
        <div id="temperatureTab" class="tab-content">
            <ul class="sub-tabs">
                <li class="sub-tab" data-subtab="annualTemp">Annual Temperature</li>
                <li class="sub-tab" data-subtab="monthlyTemp">Monthly Temperature</li>
            </ul>
            <!-- Sub-tab content for Annual Temperature -->
            <div class="sub-tab-content" id="annualTemp">
                <button class="plot-button deactivate" data-set="slideTemperatures" data-type="annual_temperature">Annual Temperature</button>
            </div>
            <!-- Sub-tab content for Monthly Temperature -->
            <div class="sub-tab-content" id="monthlyTemp">
                {{#each months}}
                    <button class="plot-button deactivate" data-set="slideMonthlyTemperatures" data-type="annual_{{this.short}}_temperature" data-cat="{{this.short}}">{{this.full}}</button>
                {{/each}}
            </div>
        </div>

        <!-- Example Precipitation Tab Content -->
        <div id="precipitationTab" class="tab-content">
            <ul class="sub-tabs">
                <li class="sub-tab" data-subtab="annualPrec">Annual Precipitation</li>
                <li class="sub-tab" data-subtab="monthlyPrec">Monthly Precipitation</li>
            </ul>
            <div class="sub-tab-content" id="annualPrec">
                <button class="plot-button deactivate" data-set="slidePrecipitation" data-type="annual_precipitation">Annual Precipitation</button>
            </div>
            <div class="sub-tab-content" id="monthlyPrec">
                {{#each months}}
                    <button class="plot-button deactivate" data-set="viz-{{this.short}}-temp" data-type="annual_{{this.short}}_precipitation" data-cat="{{this.short}}">{{this.full}}</button>
                {{/each}}
            </div>
        </div>

        <div id="growingSeasonTab" class="tab-content">
            <button class="plot-button deactivate" data-set="slideGrowingSeasonWeeks" data-type="growing_season_weeks">Growing Season Weeks</button>
            <button class="plot-button deactivate" data-set="slideGrowingSeasonDays" data-type="growing_season_days">Growing Season Days</button>
        </div>
        <div id="atmosphereTab" class="tab-content">
            <button class="plot-button deactivate" data-set="annualAtmosphere" data-type="annual_atmosphere">Annual Atmosphere</button>
        </div>
        <div id="lakesTab" class="tab-content">
            <button class="plot-button deactivate" data-set="slideLakeIceTime" data-type="annual_ice_time">Annual Lakes</button>
            <button class="plot-button deactivate" data-set="slideLakeIceFreezeup" data-type="annual_freezeup">Annual Lakes</button>
            <button class="plot-button deactivate" data-set="slideLakeIceBreakup" data-type="annual_breakup">Annual Lakes</button>
        </div>
        <div id="permafrostTab" class="tab-content">
            <button class="plot-button deactivate" data-set="annualPermafrost" data-type="annual_permafrost">Annual Permafrost</button>
        </div>
        <div id="snowDepthTab" class="tab-content">
            <button class="plot-button deactivate" data-set="annualAvgSnowDepth" data-type="annual_snowdepth_meter">Annual Snow Depth</button>
            <button class="plot-button deactivate" data-set="abiskoSnowDepthPeriodMeans" data-type="period_snowdepth">30 year period Snow Depth</button>
            <button class="plot-button deactivate" data-set="abiskoSnowDepthPeriodMeans2" data-type="period_snowdepth">Decade Snow Depth</button>
        </div>
    </div>
</div>

<!-- Scripts -->
<script>
    $(document).ready(function() {
        // Handle main tab click events
        $('.tab').click(function() {
            const tabId = $(this).data('tab');

            // Set active class for clicked tab
            $('.tab').removeClass('target');
            $(this).addClass('target');

            // Hide all main tab content and show selected
            $('.tab-content').removeClass('target');
            $('#' + tabId).addClass('target');

            // Reset sub-tab visibility to show the first sub-tab by default
            $('#' + tabId).find('.sub-tab').removeClass('target');
            $('#' + tabId).find('.sub-tab:first').addClass('target');
            $('#' + tabId).find('.sub-tab-content').removeClass('target');
            $('#' + tabId).find('.sub-tab-content:first').addClass('target');
        });

        // Handle sub-tab click events within each main tab
        $('.sub-tab').click(function() {
            const subTabId = $(this).data('subtab');
            const parentTab = $(this).closest('.tab-content');

            // Set active class for clicked sub-tab
            parentTab.find('.sub-tab').removeClass('target');
            $(this).addClass('target');

            // Hide all sub-tab content within parent tab and show selected
            parentTab.find('.sub-tab-content').removeClass('target');
            $('#' + subTabId).addClass('target');
        });
    });

</script>
{{!-- Scripts --}}
<script src="/client/map.index.js"></script>

</body>
</html>
